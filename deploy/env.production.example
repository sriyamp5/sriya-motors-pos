# Settings for the hosted (online) server.
# Copy to /opt/sriya-pos/.env on the server and fill in the values.
# Never commit the real file to Git.

# MySQL connection (the database runs on the same server).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sriya_pos
DB_PASSWORD=change-me-to-a-long-random-password
DB_NAME=sriya_pos

# Secret used to sign login sessions. At least 32 characters.
# Create one with:  openssl rand -hex 48
JWT_SECRET=paste-the-output-of-openssl-rand-here

# The application listens only on this computer; Caddy publishes it with HTTPS.
HOST=127.0.0.1
PORT=4600

# Where logs and settings are stored, and where backups are written.
SRIYA_DATA_DIR=/var/lib/sriya-pos
BACKUP_DIR=/var/lib/sriya-pos/backups
